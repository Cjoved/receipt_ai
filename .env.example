# Copy this file to `.env` and fill real values.

# Wasabi / S3
WASABI_ACCESS_KEY=
WASABI_SECRET_KEY=
WASABI_BUCKET=receipt-ai
WASABI_REGION=us-east-1
WASABI_ENDPOINT=https://s3.us-east-1.wasabisys.com

# Kimi / LLM
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.ai/v1
KIMI_CHAT_MODEL=moonshot-v1-8k
KIMI_VISION_MODEL=moonshot-v1-8k-vision-preview
KIMI_TIMEOUT_SECONDS=60

# Embeddings / RAG
FASTEMBED_MODEL=BAAI/bge-small-en-v1.5
RAG_TOP_K=8

# Extraction strictness
EXTRACTION_REQUIRE_RECEIPT_SIGNALS=true

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=receipt_chunks
# QDRANT_API_KEY=

# PostgreSQL (Phase 2+ wiring)
DATABASE_URL=postgresql://receipt_ai:receipt_ai_dev@localhost:5432/receipt_ai

# Seeder safety controls (dev-only)
APP_ENV=dev
ALLOW_SEED=false

# Optional seed defaults (used by `python -m receipt_ai.features.auth.seed_admin`)
SEED_ADMIN_EMAIL=admin@receipt.ai
SEED_ADMIN_PASSWORD=change_me_please_with_strong_password
SEED_ADMIN_DISPLAY_NAME=Admin
